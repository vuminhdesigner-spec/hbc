{
  "$schema": "https://design-system.local/component.schema.json",
  "$description": "Registry của component drawer. Hướng dẫn dùng nằm ở drawer.md.",
  "name": "drawer",
  "block": ".drawer",
  "sources": {
    "stylesheet": "ds/styles/drawer.css",
    "contract": "ds/components/drawer.md"
  },
  "api": {
    "modifiers": [
      ".drawer--fit",
      ".drawer--lg",
      ".drawer--md",
      ".drawer--sm"
    ],
    "parts": [
      ".drawer__body",
      ".drawer__close",
      ".drawer__expand",
      ".drawer__footer",
      ".drawer__header",
      ".drawer__header-actions",
      ".drawer__header-steps",
      ".drawer__heading",
      ".drawer__minimize",
      ".drawer__panel",
      ".drawer__scrim",
      ".drawer__status",
      ".drawer__status-action",
      ".drawer__supporting",
      ".drawer__title",
      ".drawer__title-name",
      ".drawer__toolbar"
    ],
    "stateClasses": [
      ".is-expanded",
      ".is-minimized"
    ],
    "pseudoStates": [
      ":focus"
    ],
    "attributes": [
      "[hidden]",
      "[data-drawer-expandable]",
      "[data-drawer-minimizable]"
    ]
  },
  "tokens": [
    "--app-border",
    "--app-radius",
    "--utui-button-height-md",
    "--utui-button-link-color",
    "--utui-color-bg-surface-hover",
    "--utui-color-brand-600",
    "--utui-color-gray-500",
    "--utui-color-icon-default",
    "--utui-color-icon-strong",
    "--utui-color-neutral-50",
    "--utui-color-text-primary",
    "--utui-color-text-secondary",
    "--utui-drawer-bg",
    "--utui-drawer-footer-gap",
    "--utui-drawer-footer-padding-y",
    "--utui-drawer-gutter",
    "--utui-drawer-header-gap",
    "--utui-drawer-padding-x",
    "--utui-drawer-scrim",
    "--utui-drawer-scrim-blur",
    "--utui-drawer-shadow",
    "--utui-drawer-toolbar-gap",
    "--utui-drawer-width",
    "--utui-drawer-width-lg",
    "--utui-drawer-width-md",
    "--utui-drawer-width-sm",
    "--utui-font-size-text-sm",
    "--utui-font-size-text-xl",
    "--utui-font-weight-regular",
    "--utui-font-weight-semibold",
    "--utui-line-height-text-sm",
    "--utui-line-height-text-xl",
    "--utui-spacing-02",
    "--utui-spacing-05",
    "--utui-touch-target-min"
  ],
  "breakpoints": [],
  "audit": {
    "hardcodedColors": []
  }
}
