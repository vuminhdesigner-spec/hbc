{
  "$schema": "https://design-system.local/component.schema.json",
  "$description": "Registry của component folder. Hướng dẫn dùng nằm ở folder.md.",
  "name": "folder",
  "block": ".folder",
  "sources": {
    "stylesheet": "ds/styles/folder.css",
    "contract": "ds/components/folder.md"
  },
  "api": {
    "modifiers": [
      ".folder--bare",
      ".folder--compact"
    ],
    "parts": [
      ".folder__col",
      ".folder__expand",
      ".folder__head",
      ".folder__nav",
      ".folder__title",
      ".folder-item",
      ".folder-item__check",
      ".folder-item__chevron",
      ".folder-item__chevron--empty",
      ".folder-item__icon",
      ".folder-item__label",
      ".folder-item__meta"
    ],
    "stateClasses": [
      ".is-active",
      ".is-wide"
    ],
    "pseudoStates": [
      ":hover"
    ],
    "attributes": [
      "[aria-level]"
    ]
  },
  "tokens": [
    "--app-radius-pill",
    "--utui-color-bg-surface",
    "--utui-color-border-default",
    "--utui-color-brand-50",
    "--utui-color-brand-500",
    "--utui-color-brand-600",
    "--utui-color-neutral-50",
    "--utui-color-bg-surface-hover",
    "--utui-color-icon-default",
    "--utui-color-text-secondary",
    "--utui-folder-expand-hover-bg",
    "--utui-folder-expand-icon",
    "--utui-folder-expand-radius",
    "--utui-folder-expand-size",
    "--utui-folder-meta-width",
    "--utui-font-size-display-xs",
    "--utui-font-size-text-sm",
    "--utui-font-size-text-xs",
    "--utui-font-weight-medium",
    "--utui-font-weight-semibold",
    "--utui-line-height-display-xs",
    "--utui-line-height-text-sm",
    "--utui-line-height-text-xs",
    "--utui-radius-md",
    "--utui-radius-sm",
    "--utui-radius-xl",
    "--utui-shadow-xs",
    "--utui-spacing-01",
    "--utui-spacing-02",
    "--utui-spacing-03",
    "--utui-spacing-04",
    "--utui-spacing-06",
    "--utui-table-border",
    "--utui-table-header-bg",
    "--utui-table-header-height",
    "--utui-table-muted-text",
    "--utui-table-scrollbar-size",
    "--utui-table-scrollbar-thumb",
    "--utui-table-scrollbar-thumb-active",
    "--utui-table-scrollbar-thumb-hover",
    "--utui-table-scrollbar-track"
  ],
  "breakpoints": [
    "max-width: 1023px"
  ],
  "audit": {
    "hardcodedColors": []
  }
}
