{
  "$schema": "https://design-system.local/component.schema.json",
  "$description": "Viết tay (luật 3 CLAUDE.md). Hướng dẫn dùng nằm ở notification.md.",
  "name": "notification",
  "block": ".notification",
  "sources": {
    "stylesheet": "ds/styles/notification.css",
    "contract": "ds/components/notification.md"
  },
  "api": {
    "modifiers": [
      ".notification--alert"
    ],
    "parts": [
      ".notification__actions",
      ".notification__body",
      ".notification__close",
      ".notification__description",
      ".notification__text",
      ".notification__title"
    ],
    "stateClasses": [],
    "pseudoStates": [
      ":hover"
    ],
    "attributes": [
      "[hidden]"
    ],
    "hooks": [
      ".notification--info",
      ".notification--success",
      ".notification--warning"
    ],
    "hooksNote": "Tone hooks set by notification.js; no CSS rule (only --alert has one)."
  },
  "tokens": [
    "--app-border",
    "--app-radius",
    "--app-text",
    "--utui-color-bg-surface",
    "--utui-color-bg-surface-subtle",
    "--utui-color-border-strong",
    "--utui-color-gray-400",
    "--utui-color-gray-600",
    "--utui-color-gray-900",
    "--utui-font-size-text-sm",
    "--utui-font-weight-medium",
    "--utui-line-height-text-sm",
    "--utui-radius-lg",
    "--utui-shadow-lg",
    "--utui-spacing-01",
    "--utui-spacing-02",
    "--utui-spacing-03",
    "--utui-spacing-04",
    "--utui-spacing-06",
    "--utui-spacing-08",
    "--utui-touch-target-min"
  ],
  "breakpoints": [],
  "audit": {
    "hardcodedColors": []
  }
}
