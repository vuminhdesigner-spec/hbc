{
  "$schema": "https://design-system.local/component.schema.json",
  "$description": "Registry của component attachment. Hướng dẫn dùng nằm ở attachment.md.",
  "name": "attachment",
  "block": ".attachment-pane",
  "sources": {
    "stylesheet": "ds/styles/attachment.css",
    "contract": "ds/components/attachment.md"
  },
  "api": {
    "modifiers": [
      ".attachment-pane--bare"
    ],
    "parts": [
      ".attachment-pane__body",
      ".attachment-pane__collapse",
      ".attachment-pane__expand",
      ".attachment-pane__file",
      ".attachment-pane__footer",
      ".attachment-pane__header",
      ".attachment-pane__heading",
      ".attachment-pane__icon",
      ".attachment-pane__lead",
      ".attachment-pane__page",
      ".attachment-pane__pager",
