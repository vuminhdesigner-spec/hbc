    "--utui-attachment-icon-ring",
    "--utui-attachment-lead-gap",
    "--utui-attachment-padding",
    "--utui-attachment-page-radius",
    "--utui-attachment-page-size",
    "--utui-attachment-radius",
    "--utui-attachment-shadow",
    "--utui-attachment-supporting-text",
    "--utui-attachment-text-gap",
    "--utui-color-bg-surface-hover",
    "--utui-font-size-text-lg",
    "--utui-font-size-text-sm",
    "--utui-font-weight-semibold",
    "--utui-line-height-text-lg",
    "--utui-line-height-text-sm",
    "--utui-spacing-02"
  ],
  "breakpoints": [],
  "audit": {
    "hardcodedColors": []
  }
