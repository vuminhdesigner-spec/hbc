{
  "$schema": "https://design-system.local/component.schema.json",
  "$description": "Registry của component resize-handle. Hướng dẫn dùng nằm ở resize-handle.md.",
  "name": "resize-handle",
  "block": ".resize-handle",
  "sources": {
    "stylesheet": "ds/styles/resize-handle.css",
